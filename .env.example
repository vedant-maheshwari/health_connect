# Database Configuration
DATABASE_URL=postgresql://telehealth_user:telehealth_password@postgres:5432/telehealth

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://auth-service:8000
PATIENT_SERVICE_URL=http://patient-service:8000
DOCTOR_SERVICE_URL=http://doctor-service:8000
APPOINTMENT_SERVICE_URL=http://appointment-service:8000
FAMILY_SERVICE_URL=http://family-service:8000
CHAT_SERVICE_URL=http://chat-service:8000
ADMIN_SERVICE_URL=http://admin-service:8000

# Environment
ENVIRONMENT=development
